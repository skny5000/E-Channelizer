{
  "Application": {
    "Name": "E-Channelizer",
    "Version": "1.0.0",
    "AutoCheckUpdates": true,
    "UpdateChannel": "Stable"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "EChannelizer": "Debug"
    },
    "File": {
      "Path": "Logs/e-channelizer.log",
      "MaxFileSize": "10MB",
      "MaxFiles": 10
    }
  },
  "Repository": {
    "DefaultPath": "",
    "AutoSave": false,
    "BackupOnSave": true
  },
  "UI": {
    "Theme": "Dark",
    "AccentColor": "Blue",
    "Language": "en",
    "FontSize": 12,
    "ShowToolTips": true,
    "ShowKeyboardShortcuts": true
  },
  "Channels": {
    "AutoAssignNumbers": true,
    "AutoAssignEpg": true,
    "DefaultSort": "Number",
    "ShowNumbers": true,
    "ShowIcons": true,
    "ShowFlags": true
  },
  "Streaming": {
    "PlayerPath": "",
    "PlayerArguments": "",
    "StreamlinkPath": "",
    "DefaultBuffering": "Medium",
    "DefaultBufferSize": 1024,
    "Timeout": 30
  },
  "Network": {
    "ConnectionTimeout": 10,
    "OperationTimeout": 30,
    "AutoConnect": false
  },
  "EPG": {
    "UpdateInterval": 24,
    "RetentionDays": 7,
    "AutoUpdate": true
  },
  "Logos": {
    "Folder": "",
    "AutoDownload": true,
    "MaxSize": 200,
    "Format": "png"
  }
}
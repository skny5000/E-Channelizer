<controls:MetroWindow x:Class="EChannelizer.Views.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:EChannelizer.ViewModels"
        xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="Import Data"
        Height="550"
        Width="700"
        WindowStartupLocation="CenterOwner"
        GlowBrush="{DynamicResource MahApps.Brushes.Accent}">

    <controls:MetroWindow.DataContext>
        <local:ImportViewModel />
    </controls:MetroWindow.DataContext>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Import Type -->
        <GroupBox Grid.Row="0" Header="Import Type" Margin="0,0,0,16">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding AvailableSatellites}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding}" Margin="4,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <RadioButton Content="Satellites" GroupName="ImportType"
                             Command="{Binding ImportSatellitesCommand}" IsChecked="{Binding SelectedImportType, ConverterParameter=Satellites, Converter={StaticResource EnumToBooleanConverter}}" Margin="0,4,0,0" />
                <RadioButton Content="Transponders" GroupName="ImportType"
                             Command="{Binding ImportTranspondersCommand}" Margin="0,4,0,0" />
                <RadioButton Content="Channels" GroupName="ImportType" Margin="0,4,0,0" />
                <RadioButton Content="EPG (XMLTV)" GroupName="ImportType" Margin="0,4,0,0" />
                <RadioButton Content="Logos" GroupName="ImportType" Margin="0,4,0,0" />
                <RadioButton Content="M3U Playlist" GroupName="ImportType" Margin="0,4,0,0" />
                <RadioButton Content="Repository (.ech/.zip)" GroupName="ImportType" Margin="0,4,0,0" />
            </StackPanel>
        </GroupBox>

        <!-- File Selection -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Source File:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" />

            <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Content="Browse..."
                    Command="{Binding BrowseSourceCommand}" Margin="0,8,0,0" Padding="12,4" HorizontalAlignment="Left" />

            <!-- Options -->
            <GroupBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Header="Import Options" Margin="0,16,0,0">
                <StackPanel Margin="8">
                    <CheckBox Content="Create Backup" IsChecked="{Binding CreateBackup}" Margin="0,4" />
                    <CheckBox Content="Create Groups" IsChecked="{Binding CreateGroups}" Margin="0,4" />
                    <CheckBox Content="Download Missing Logos" IsChecked="{Binding DownloadMissingLogos}" Margin="0,4" />

                    <TextBlock Text="Target Satellite:" Margin="0,12,0,4" />
                    <TextBox Text="{Binding TargetSatellite}" Margin="0,0,0,8" />

                    <TextBlock Text="Satellite Options:" Margin="0,4" />
                    <ComboBox ItemsSource="{Binding SatelliteOptions}" SelectedItem="{Binding SelectedSatelliteOption}" Margin="0,0,0,8" />

                    <TextBlock Text="DVB Options:" Margin="0,4" />
                    <ComboBox ItemsSource="{Binding DvbOptions}" SelectedItem="{Binding SelectedDvbOption}" Margin="0,0,0,8" />
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Command="{Binding CancelCommand}" Width="100" Margin="8,0,0,0" />
            <Button Content="Import" Command="{Binding ImportCommand}" Width="100" Margin="8,0,0,0"
                    Style="{StaticResource MahApps.Styles.Button.Dialogs.Accent}" />
        </StackPanel>

        <controls:ProgressRing Grid.Row="1" Grid.ColumnSpan="2" Width="32" Height="32"
                               Visibility="{Binding IsImporting, Converter={StaticResource BoolToVisibilityConverter}}"
                               IsActive="{Binding IsImporting}" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</controls:MetroWindow>
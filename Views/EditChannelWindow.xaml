<controls:MetroWindow x:Class="EChannelizer.Views.EditChannelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="Edit Channel"
        Height="700"
        Width="800"
        WindowStartupLocation="CenterOwner"
        GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
        ShowMinButton="False">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Basic Info -->
                <GroupBox Header="Basic Information" Margin="0,0,0,12">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Name:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,4" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" Margin="0,4" />

                        <TextBlock Text="Number:" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="8,4,0,4" />
                        <TextBox Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="3" Margin="0,4" />

                        <TextBlock Text="Service Type:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,4" />
                        <ComboBox ItemsSource="{Binding ServiceTypes}" SelectedItem="{Binding ServiceType}" Grid.Row="1" Grid.Column="1" Margin="0,4" />

                        <TextBlock Text="Service ID:" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="8,4,0,4" />
                        <TextBox Text="{Binding ServiceId, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="3" Margin="0,4" />

                        <TextBlock Text="Provider:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,4" />
                        <TextBox Text="{Binding Provider, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1" Margin="0,4" />

                        <TextBlock Text="Satellite:" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Margin="8,4,0,4" />
                        <ComboBox ItemsSource="{Binding AvailableSatellites}" SelectedItem="{Binding Satellite}" Grid.Row="2" Grid.Column="3" Margin="0,4" />

                        <TextBlock Text="Network ID:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,4" />
                        <TextBox Text="{Binding NetworkId, UpdateSourceTrigger=PropertyChanged}" Grid.Row="3" Grid.Column="1" Margin="0,4" />

                        <TextBlock Text="TS ID:" Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" Margin="8,4,0,4" />
                        <TextBox Text="{Binding TransportStreamId, UpdateSourceTrigger=PropertyChanged}" Grid.Row="3" Grid.Column="3" Margin="0,4" />
                    </Grid>
                </GroupBox>

                <!-- Flags -->
                <GroupBox Header="Channel Flags" Margin="0,0,0,12">
                    <WrapPanel Margin="8">
                        <CheckBox Content="Scrambled" IsChecked="{Binding IsScrambled}" Margin="0,4,16,4" />
                        <CheckBox Content="Hidden" IsChecked="{Binding IsHidden}" Margin="0,4,16,4" />
                        <CheckBox Content="Favorite" IsChecked="{Binding IsFavorite}" Margin="0,4,16,4" />
                        <CheckBox Content="Locked" IsChecked="{Binding IsLocked}" Margin="0,4,16,4" />
                        <CheckBox Content="Skip" IsChecked="{Binding IsSkip}" Margin="0,4,16,4" />
                        <CheckBox Content="HD" IsChecked="{Binding IsHD}" Margin="0,4,16,4" />
                        <CheckBox Content="UHD" IsChecked="{Binding IsUHD}" Margin="0,4,16,4" />
                        <CheckBox Content="HEVC" IsChecked="{Binding IsHEVC}" Margin="0,4,16,4" />
                        <CheckBox Content="AC3" IsChecked="{Binding HasAC3}" Margin="0,4,16,4" />
                        <CheckBox Content="AAC" IsChecked="{Binding HasAAC}" Margin="0,4,16,4" />
                        <CheckBox Content="Subtitles" IsChecked="{Binding HasSubtitles}" Margin="0,4,16,4" />
                        <CheckBox Content="Teletext" IsChecked="{Binding HasTeletext}" Margin="0,4,16,4" />
                    </WrapPanel>
                </GroupBox>

                <!-- Logo -->
                <GroupBox Header="Logo" Margin="0,0,0,12">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="80" Height="80" BorderBrush="{DynamicResource MahApps.Brushes.Gray5}"
                                BorderThickness="1" Margin="0,0,12,0" Background="{DynamicResource MahApps.Brushes.Gray10}">
                            <Image Source="{Binding LogoPath}" Stretch="Uniform" />
                        </Border>

                        <TextBox Grid.Column="1" Text="{Binding LogoPath, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center" IsReadOnly="True" />

                        <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseLogoCommand}"
                                Margin="8,0,0,0" Padding="12,4" VerticalAlignment="Center" />
                        <Button Grid.Column="3" Content="Clear" Command="{Binding ClearLogoCommand}"
                                Margin="8,0,0,0" Padding="12,4" VerticalAlignment="Center" />
                    </Grid>
                </GroupBox>

                <!-- DVB-S -->
                <GroupBox Header="DVB-S/S2 (Satellite)" Margin="0,0,0,12"
                          Visibility="{Binding IsDvbsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Frequency (kHz):" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,4" />
                        <TextBox Text="{Binding Frequency, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" Margin="0,4" />

                        <TextBlock Text="Polarization:" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="8,4,0,4" />
                        <ComboBox ItemsSource="{Binding Polarizations}" SelectedItem="{Binding Polarization}" Grid.Row="0" Grid.Column="3" Margin="0,4" />

                        <TextBlock Text="Symbol Rate (ksym/s):" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,4" />
                        <TextBox Text="{Binding SymbolRate, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" Margin="0,4" />

                        <TextBlock Text="FEC:" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="8,4,0,4" />
                        <ComboBox ItemsSource="{Binding FecOptions}" SelectedItem="{Binding Fec}" Grid.Row="1" Grid.Column="3" Margin="0,4" />

                        <TextBlock Text="Modulation:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,4" />
                        <ComboBox ItemsSource="{Binding Modulations}" SelectedItem="{Binding Modulation}" Grid.Row="2" Grid.Column="1" Margin="0,4" />

                        <CheckBox Content="DVB-S2" IsChecked="{Binding IsDvbS2}" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" VerticalAlignment="Center" Margin="8,4,0,4" />
                    </Grid>
                </GroupBox>

                <!-- DVB-C -->
                <GroupBox Header="DVB-C/C2 (Cable)" Margin="0,0,0,12"
                          Visibility="{Binding IsDvbcVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Frequency (kHz):" Grid.Column="0" VerticalAlignment="Center" Margin="0,4" />
                        <TextBox Text="{Binding Frequency, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" Margin="0,4" />

                        <TextBlock Text="Symbol Rate (ksym/s):" Grid.Column="2" VerticalAlignment="Center" Margin="8,4,0,4" />
                        <TextBox Text="{Binding SymbolRate, UpdateSourceTrigger=PropertyChanged}" Grid.Column="3" Margin="0,4" />
                    </Grid>
                </GroupBox>

                <!-- DVB-T -->
                <GroupBox Header="DVB-T/T2 (Terrestrial)" Margin="0,0,0,12"
                          Visibility="{Binding IsDvbtVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Frequency (kHz):" Grid.Column="0" VerticalAlignment="Center" Margin="0,4" />
                        <TextBox Text="{Binding Frequency, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" Margin="0,4" />

                        <TextBlock Text="Bandwidth (MHz):" Grid.Column="2" VerticalAlignment="Center" Margin="8,4,0,4" />
                        <ComboBox ItemsSource="{Binding Bandwidths}" SelectedItem="{Binding Bandwidth}" Grid.Column="3" Margin="0,4" />
                    </Grid>
                </GroupBox>

                <!-- IPTV -->
                <GroupBox Header="IPTV / Stream" Margin="0,0,0,12"
                          Visibility="{Binding IsIptvVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Stream URL:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,4" />
                        <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" Margin="0,4" />
                        <Button Grid.Row="0" Grid.Column="2" Content="Test" Command="{Binding TestStreamCommand}" Margin="8,4,0,4" Padding="12,4" />

                        <TextBlock Text="Stream Type:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,4" />
                        <ComboBox ItemsSource="{Binding StreamTypes}" SelectedItem="{Binding StreamType}" Grid.Row="1" Grid.Column="1" Margin="0,4" />

                        <TextBlock Text="User Agent:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,4" />
                        <TextBox Text="{Binding UserAgent, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4" />
                    </Grid>
                </GroupBox>

                <!-- EPG -->
                <GroupBox Header="EPG Sources" Margin="0,0,0,12">
                    <StackPanel Margin="8">
                        <ListBox ItemsSource="{Binding EpgSources}" Height="80" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding NewEpgSource, UpdateSourceTrigger=PropertyChanged}" Width="400" />
                            <Button Content="Add" Command="{Binding AddEpgSourceCommand}" Margin="8,0,0,0" Padding="12,4" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <TextBlock Text="{Binding ValidationErrors}" Foreground="{DynamicResource MahApps.Brushes.Red}"
                           TextWrapping="Wrap" Margin="0,8" />
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" Width="100" Margin="0,0,8,0" />
            <Button Content="Save" Command="{Binding OKCommand}" Width="100"
                    Style="{StaticResource MahApps.Styles.Button.Dialogs.Accent}" IsDefault="True" />
        </StackPanel>
    </Grid>
</controls:MetroWindow>
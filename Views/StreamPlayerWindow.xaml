<controls:MetroWindow x:Class="EChannelizer.Views.StreamPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="Stream Player"
        Height="500"
        Width="800"
        WindowStartupLocation="CenterOwner"
        GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
        Closing="MetroWindow_Closing">

    <controls:MetroWindow.DataContext>
        <local:StreamPlayerViewModel />
    </controls:MetroWindow.DataContext>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Channel Info -->
        <GroupBox Grid.Row="0" Header="Channel Info" Margin="0,0,0,16">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="80" Height="80" BorderBrush="{DynamicResource MahApps.Brushes.Gray5}"
                        BorderThickness="1" Margin="0,0,12,0" Background="{DynamicResource MahApps.Brushes.Gray10}">
                    <Image Source="{Binding Channel.LogoPath}" Stretch="Uniform" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Channel.Name}" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="{Binding Channel.Satellite}" FontSize="14" Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                    <TextBlock Text="{Binding Channel.Provider}" FontSize="12" Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Status}" FontSize="14" FontWeight="Bold"
                               Foreground="{Binding Status, Converter={StaticResource PlayerStatusToColorConverter}}" VerticalAlignment="Center" />
                    <TextBlock Text=" | " VerticalAlignment="Center" Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Video Placeholder / Stream Info -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource MahApps.Brushes.Gray5}" BorderThickness="1" Background="{DynamicResource MahApps.Brushes.Gray10}"
                Margin="0,0,0,16">
            <Grid>
                <TextBlock Text="Stream would be rendered here via external player (VLC, MPV, etc.)"
                           VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
            </Grid>
        </Border>

        <!-- Controls -->
        <GroupBox Grid.Row="2" Header="Playback Controls">
            <StackPanel Margin="8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Play" Command="{Binding PlayCommand}" Width="100" Padding="12,8" Margin="0,0,8,0"
                            Style="{StaticResource MahApps.Styles.Button.Dialogs.Accent}" />
                    <Button Content="Pause" Command="{Binding PauseCommand}" Width="100" Padding="12,8" Margin="0,0,8,0" />
                    <Button Content="Stop" Command="{Binding StopCommand}" Width="100" Padding="12,8" Margin="0,0,8,0" />
                    <Button Content="Mute" Command="{Binding ToggleMuteCommand}" Width="100" Padding="12,8" Margin="0,0,8,0" />
                    <Slider Width="200" Minimum="0" Maximum="1" Value="{Binding Volume}" VerticalAlignment="Center" Margin="16,0,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <TextBlock Text="Volume:" VerticalAlignment="Center" Margin="0,0,8,0" />
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Bottom Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Close" Command="{Binding ClosePlayerCommand}" Width="100"
                    Style="{StaticResource MahApps.Styles.Button.Dialogs.Accent}" />
        </StackPanel>
    </Grid>
</controls:MetroWindow>
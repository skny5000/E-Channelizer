<controls:MetroWindow x:Class="EChannelizer.Views.BatchEditEpgWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="Batch Edit EPG"
        Height="500"
        Width="700"
        WindowStartupLocation="CenterOwner"
        GlowBrush="{DynamicResource MahApps.Brushes.Accent}">

    <controls:MetroWindow.DataContext>
        <local:BatchEditEpgViewModel />
    </controls:MetroWindow.DataContext>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- EPG Sources -->
        <GroupBox Grid.Row="0" Header="EPG Sources" Margin="0,0,0,16">
            <DataGrid ItemsSource="{Binding EpgSources}" SelectedItem="{Binding SelectedEpgSource}"
                      AutoGenerateColumns="False" SelectionMode="Single"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      Style="{StaticResource MetroDataGrid}" Height="150">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100" IsReadOnly="True" />
                    <DataGridTextColumn Header="File/URL" Binding="{Binding FilePath}" Width="200" IsReadOnly="True" />
                    <DataGridTextColumn Header="Last Update" Binding="{Binding LastUpdate, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="150" IsReadOnly="True" />
                    <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding IsEnabled}" Width="70" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Actions -->
        <GroupBox Grid.Row="1" Header="Batch Operations" Margin="0,0,0,16">
            <StackPanel Margin="8">
                <Button Content="Auto-map EPG to Channels" Command="{Binding AutoMapCommand}" Padding="12,4" Margin="0,0,0,8"
                        Style="{StaticResource MahApps.Styles.Button.Dialogs.Accent}" HorizontalAlignment="Left" />
                <Button Content="Clear All Mappings" Command="{Binding ClearMappingsCommand}" Padding="12,4" Margin="0,0,0,8" HorizontalAlignment="Left" />
                <Separator Margin="0,8" />
                <Button Content="Import XMLTV File" Command="{Binding ImportEpgCommand}" Padding="12,4" HorizontalAlignment="Left" />
            </StackPanel>
        </GroupBox>

        <!-- Stats -->
        <GroupBox Grid.Row="1" Grid.RowSpan="2" Header="Statistics" Margin="8,0,0,0" VerticalAlignment="Bottom">
            <StackPanel Margin="8">
                <TextBlock Text="{Binding MappedCount, StringFormat='Mapped: {0}'}" Margin="0,2" FontWeight="Bold" />
                <TextBlock Text="{Binding UnmappedXmlCount, StringFormat='Unmapped XMLTV: {0}'}" Margin="0,2" />
                <TextBlock Text="{Binding UnmappedChannelCount, StringFormat='Unmapped Channels: {0}'}" Margin="0,2" />
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Close" Command="{Binding CancelCommand}" Width="100" />
        </StackPanel>
    </Grid>
</controls:MetroWindow>